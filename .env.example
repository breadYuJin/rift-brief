# 비워 두면 가상 팀으로 만든 샘플 데이터로 돈다.
PANDASCORE_TOKEN=

# 비워 두면 언어 모델 없이 규칙 기반 문장으로 작성한다.
# 형식은 "제공사:모델명". 제공사에 맞는 키 하나만 채우면 된다.
#   anthropic:claude-haiku-5-5   → ANTHROPIC_API_KEY
#   google_genai:<모델명>         → GOOGLE_API_KEY
#   openai:<모델명>               → OPENAI_API_KEY
LLM_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# 선택: 리그 이름(쉼표 구분) 또는 PandaScore 리그 ID 직접 지정
# LEAGUES=LCK,Worlds,Mid-Season Invitational
# PANDASCORE_LEAGUE_IDS=

# 선택: 로컬 모델(Ollama)로 글과 모의 밴픽을 쓸 때. LLM_MODEL=ollama:<모델명> 과 함께 쓴다.
# OLLAMA_BASE_URL=http://localhost:11434

# 선택: 공식 채널(@LCK) 영상 목록 수집과 명장면 링크. 켜는 순서는 BACKLOG.md 참고.
# YOUTUBE_API_KEY=
# HIGHLIGHT_LINKS=1
# HIGHLIGHT_OFFSET_SEC=0

# 선택: 실시간 밴픽 (GRID 접근 권한을 받은 뒤, 연결부 구현 필요)
# GRID_API_KEY=
